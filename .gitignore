venv/

# Everything cached under data/raw/ is disposable EXCEPT the OMNI2 text
# responses. Those are the exact upstream bytes the published results were
# computed from, they total ~170 KB, and committing them means a fresh clone
# (and the deployed dashboard) reproduces RESULTS.md with no network access.
data/raw/*
!data/raw/omniweb/
data/raw/omniweb/*
!data/raw/omniweb/*.txt
data/processed/

.env
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Local Claude Code settings (machine-specific, not shared)
.claude/settings.local.json
